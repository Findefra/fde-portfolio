# Copy to .env and adjust as needed
APP_NAME=ops-knowledge-assistant
ENVIRONMENT=local
DEBUG=true

API_PREFIX=/api/v1
API_KEYS=dev-key-admin,dev-key-sre,dev-key-viewer

# Database (used later when switching from in-memory store)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ops_kb
EMBEDDING_DIMENSION=1536

LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

TOP_K=6
MIN_SIMILARITY=0.1

CORPUS_PATH=../data/corpus
